# ─────────────────────────────────────────────────────────────────────────────
#  AI Customer Support Agent — Environment Configuration
#  Copy this file to .env and fill in the values you have.
#  Leave unused providers blank — the system will use the first available key.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Provider (choose ONE, or set AGENT_MODE=mock for no API calls) ───────
# Google Gemini (recommended for cost-efficiency)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (GPT-4o-mini recommended)
OPENAI_API_KEY=

# Groq (llama-3.1-70b-versatile — fast and free tier available)
GROQ_API_KEY=

# ── Agent Behaviour ───────────────────────────────────────────────────────────
# Options: gemini | openai | groq | mock
# "mock" returns deterministic canned responses — no API key required.
AGENT_MODE=mock

# Model name for the chosen provider (override defaults):
AGENT_MODEL=gemini/gemini-1.5-flash

# ── Embedding Provider ────────────────────────────────────────────────────────
# Options: local | openai
# "local" uses all-MiniLM-L6-v2 via sentence-transformers (no API key needed).
EMBEDDING_PROVIDER=local

# ── Application Settings ──────────────────────────────────────────────────────
LOG_LEVEL=INFO

# Max number of historical tweets to retrieve for RAG context
RAG_TOP_K=5

# Minimum intent classification confidence to auto-handle (0.0–1.0)
AUTO_HANDLE_CONFIDENCE_THRESHOLD=0.75

# Maximum output length for generated replies (characters, Twitter-like)
MAX_REPLY_CHARS=280
